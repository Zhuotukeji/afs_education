{
  "name": "career-path-brief",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next build",
    "content:audit": "tsx scripts/audit-content.ts",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "tsx scripts/seed.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:unit && pnpm run content:audit",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config vitest.int.config.mts",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "visual:check": "node scripts/visual-check.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/inter": "^5.2.7",
    "@fontsource/source-serif-4": "^5.2.7",
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "graphql": "^16.11.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.12",
    "otpauth": "^9.4.1",
    "payload": "3.86.0",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.34.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.19.9",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.12",
    "esbuild": "^0.28.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.22.4",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
